{
  "name": "qq-bridge",
  "version": "0.2.1-r1",
  "private": true,
  "license": "MIT",
  "description": "Bridge between a QQ gateway (OneBot v11) and DeepSeek Harness Web API: QQ messages become DSH agent prompts, agent replies go back to QQ. Targets the DSH Cookie-auth / slash-RPC / remote.mux protocol generation, so it deliberately names no DSH version here.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build:typed": "node scripts/build-typed-modules.mjs --write",
    "check:generated": "node scripts/build-typed-modules.mjs --check",
    "typecheck": "tsc --project tsconfig.boundaries.json",
    "start": "node src/bridge.js",
    "diagnose:acl": "node scripts/diagnose-acl.mjs",
    "harden-acl": "node scripts/harden-state-acl.mjs",
    "build:console": "node scripts/build-console-scripts.mjs --write && node scripts/build-console.mjs --write",
    "check:console": "node scripts/build-console-scripts.mjs --check && node scripts/build-console.mjs --check",
    "typecheck:console": "tsc --project tsconfig.console.json",
    "build:workbench": "node scripts/build-qq-workbench.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^4.3.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  }
}
